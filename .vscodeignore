# NOTE: node_modules IS intentionally shipped — the MCP server
# (@modelcontextprotocol/sdk, playwright, zod) must be resolvable at runtime.
# dist/server.js is the entry point referenced by contributes.mcp;
# dist/extension.js is the extension host entry referenced by "main".
